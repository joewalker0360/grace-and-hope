# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Resend Email Configuration (https://resend.com)
# Free 3,000 emails/month
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Grace & Hope <onboarding@resend.dev>"

# Optional Cron Secret to protect the daily verse trigger
CRON_SECRET=your_random_secret_string
